# Loopback configuration - copy to .env (gitignored) and fill in the secrets.
# Read by the backend (dotnet run), claude-bridge.fsx and loopback-up.cmd.

# --- Required ---------------------------------------------------------------
# Plaud account (email + password login, as on web.plaud.ai). Loopback logs in itself and keeps
# its own session renewed; the password is only used again when that renewal fails.
# Accounts created via "Continue with Google/Apple" need a password set in Plaud first;
# two-factor auth must be off.
PLAUD_EMAIL=<email>
PLAUD_PASSWORD=<password>
SPEECHMATICS_API_KEY=<Speechmatics API key>
# Any long random string - shared secret between the backend and claude-bridge.fsx.
CLAUDE_BRIDGE_TOKEN=<long random string>

# --- Optional (defaults shown) ----------------------------------------------
# Folder the result JSON files are written to (e.g. an Obsidian inbox). Relative to the repo root;
# on Windows use forward slashes: C:/Users/me/Vault/Inbox
LOOPBACK_OUTPUT=./output
PLAUD_SYNC_INTERVAL_MINUTES=5
SPEECHMATICS_MODEL=melia-1
SPEECHMATICS_LANGUAGE=multi
SPEECHMATICS_MAX_JOB_MINUTES=60
# The port is also the port claude-bridge.fsx listens on (127.0.0.1 only).
CLAUDE_BRIDGE_URL=http://host.docker.internal:9100
# Max parallel claude processes the bridge runs (keep >= the highest "passes" in workflows/).
MAX_CONCURRENCY=4
PROCESSING_POLL_SECONDS=10
